APP_MODE=live
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth web application.
# Callback: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Existing GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are also accepted.

# Facebook development application.
# Callback: http://localhost:3000/api/auth/callback/facebook
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Requires an OAuth client issued by OpenAI for website sign-in.
# Callback: http://localhost:3000/api/auth/callback/chatgpt
# Use the token authentication method assigned during registration.
AUTH_CHATGPT_ID=
AUTH_CHATGPT_SECRET=
AUTH_CHATGPT_TOKEN_AUTH_METHOD=client_secret_post

# Set to the canonical HTTPS origin in production.
# AUTH_URL=https://your-domain.example
# AUTH_TRUST_HOST=true
